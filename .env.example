# ============================================================
# VectorPilot — Environment Variable Reference
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to version control.
# Only `VITE_`-prefixed variables are exposed to the browser bundle.
# ============================================================

# --- API ---------------------------------------------------------------------

# Base URL for the backend REST API.
# When EMPTY, the app runs in mock mode using src/data/*.json.
# Example: https://api.vectorpilot.ai
VITE_API_URL=

# Optional: WebSocket endpoint for the live usage feed (ADD_EVENT stream).
# When EMPTY, the dashboard uses the built-in 4-second mock simulator.
# Example: wss://api.vectorpilot.ai/ws/usage
VITE_WS_URL=

# --- APPLICATION -------------------------------------------------------------

# Display name shown in page titles and meta tags.
VITE_APP_NAME=VectorPilot

# Application version — keep in sync with CHANGELOG.md.
VITE_APP_VERSION=1.0.0

# --- FEATURE FLAGS -----------------------------------------------------------

# Enable the live usage cost simulator (fires ADD_EVENT every 4s).
# Set to 'false' when connected to a real VITE_WS_URL feed.
VITE_ENABLE_MOCK_SIMULATOR=true

# Show the waitlist capture section on the landing page.
VITE_ENABLE_WAITLIST=true

# Enable the Copilot dashboard section.
VITE_ENABLE_COPILOT=true

# Enable team management features in Settings.
VITE_ENABLE_TEAM=true

# --- ANALYTICS / DEVELOPMENT -------------------------------------------------

# Optional analytics write key (e.g. Segment, PostHog). Empty = disabled.
VITE_ANALYTICS_KEY=

# Show a developer tools overlay in the bottom-right corner. 'false' in prod.
VITE_DEV_TOOLS=false
